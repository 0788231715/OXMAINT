APP_NAME=OxMaint
APP_VERSION=0.1.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=oxmaint_db
POSTGRES_USER=oxmaint_app
POSTGRES_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://oxmaint_app:REPLACE_WITH_A_DATABASE_PASSWORD@localhost:5432/oxmaint_db
